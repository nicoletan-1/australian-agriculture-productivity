{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "projection": { "type": "equalEarth" },
  "layer": [
    {
      "data": { "sphere": true },
      "mark": { "type": "geoshape", "fill": "#F4EFE4" }
    },
    {
      "data": {
        "url": "data/world_110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "mark": { "type": "geoshape", "fill": "#E4DEC9", "stroke": "#FFFFFF", "strokeWidth": 0.5 }
    },
    {
      "data": {
        "values": [
          { "lon_bin": -100, "lat_bin": 40, "tfp": 156.8 },
          { "lon_bin": -90, "lat_bin": 40, "tfp": 156.8 },
          { "lon_bin": -100, "lat_bin": 30, "tfp": 156.8 },
          { "lon_bin": -110, "lat_bin": 50, "tfp": 159.4 },
          { "lon_bin": -100, "lat_bin": 50, "tfp": 159.4 },
          { "lon_bin": -50, "lat_bin": -10, "tfp": 210.4 },
          { "lon_bin": -60, "lat_bin": -15, "tfp": 210.4 },
          { "lon_bin": 10, "lat_bin": 50, "tfp": 132.5 },
          { "lon_bin": 20, "lat_bin": 50, "tfp": 132.5 },
          { "lon_bin": 105, "lat_bin": 35, "tfp": 224.1 },
          { "lon_bin": 115, "lat_bin": 30, "tfp": 224.1 },
          { "lon_bin": 125, "lat_bin": 35, "tfp": 118.4 },
          { "lon_bin": 135, "lat_bin": 35, "tfp": 121.0 },
          { "lon_bin": 120, "lat_bin": -30, "tfp": 164.2 },
          { "lon_bin": 130, "lat_bin": -25, "tfp": 164.2 },
          { "lon_bin": 140, "lat_bin": -35, "tfp": 164.2 },
          { "lon_bin": 145, "lat_bin": -30, "tfp": 164.2 }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8,
        "width": 18,
        "height": 14
      },
      "encoding": {
        "longitude": { "field": "lon_bin", "type": "quantitative" },
        "latitude": { "field": "lat_bin", "type": "quantitative" },
        "color": {
          "field": "tfp",
          "type": "quantitative",
          "title": "TFP Index (1990=100)",
          "scale": { "scheme": "viridis", "domain": [115, 230] },
          "legend": { "orient": "bottom", "direction": "horizontal" }
        },
        "tooltip": [
          { "field": "tfp", "type": "quantitative", "title": "Grid Cell Mean TFP" }
        ]
      }
    }
  ]
}
